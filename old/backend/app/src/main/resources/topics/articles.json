{
    "topic": "articles",
    "authors": [
        "Adriane Boyd"
    ],
    "description": {
        "title": "Articles",
        "text": "<p>The <b>articles</b> topic just highlights the use of the words <i>a, an, the</i>. If you'd like to practice with more types of articles and determiners, try the <a href=\"/#en-determiners-panel\">determiners</a> topic.</p>"
    },
    "pipelines": [
        {
            "language": "ENGLISH",
            "descriptor": "desc/operators/OpenNlpTokenizerPipe",
            "configuration": {}
        }
    ],
    "activities": [
        {
            "activity": "color",
            "description": {
                "title": "Color",
                "text": "In the text, VIEW shows you the articles <i>a, an, the</i> in <font color=\"#ff8200\"><b>orange</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        },
        {
            "activity": "click",
            "description": {
                "title": "Click",
                "text": "Click on each article you find in the text and VIEW will show you whether you guessed <font color='green'><b>right</b></font> or <font color='red'><b>wrong</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.EnhancementsAndTokens",
                "configuration": {}
            }
        },
        {
            "activity": "cloze",
            "description": {
                "title": "Practice",
                "text": "Fill in the blanks with the <font color='green'><b>correct</b></font> article. If you guessed <font color='red'><b>wrong</b></font> or you find it too difficult you can get help by clicking on <span class='clozeStyleHint'>?</span>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        },
        {
            "activity": "mc",
            "description": {
                "title": "Multiple Choice",
                "text": "Select the correct article."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        }
    ]
}
