{
    "topic": "word-stress",
    "authors": [
        "Eduard Schaf"
    ],
    "description": {
        "title": "Russian Word Stress",
        "text": "Practice <em>Russian Word Stress</em>."
    },
    "pipelines": [
        {
            "language": "RUSSIAN",
            "descriptor": "desc/operators/HFSTRusWordStressPipe",
            "configuration": {
                "isWithTrace": "false",
                "language": "ru"
            },
            "select": [
                {
                    "type": "werti.uima.types.annot.Token",
                    "with": {},
                    "without": {}
                }
            ]
        }
    ],
    "activities": [
        {
            "activity": "color",
            "description": {
                "title": "Colour",
                "text": "In the text, VIEW shows you the stress of the Russian words in <font color='#ff8200'><b>orange</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": { "type": "hit ambiguity"}
            }
        },
        {
            "activity": "click",
            "description": {
                "title": "Click",
                "text": "Click on each stressed vowel in the Russian words you find in the text and VIEW will show you whether you guessed <font color='green'><b>right</b></font> or <font color='red'><b>wrong</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.EnhancementsAndTokens",
                "configuration": { "type": "hit ambiguity" }
            }
        },
        {
            "activity": "cloze",
            "description": {
                "title": "Fill in the Blanks",
              "text": "VIEW will show you the <font color='green'><b>correct</b></font> stress for the Russian word marked in <font color='red'><b>red</b></font> when you hover over it."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": { "type": "hit" }
            }
        },
        {
            "activity": "mc",
            "description": {
                "title": "Multiple Choice",
                "text": "Choose the Russian word with the correct stress from the drop-down list and VIEW will show you whether you guessed <font color='green'><b>right</b></font> or <font color='red'><b>wrong</b></font>. You can get help by clicking on <span class='clozeStyleHint'>?</span>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": { "type": "hit" }
            }
        }
    ]
}
