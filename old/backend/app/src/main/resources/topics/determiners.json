{
    "topic": "determiners",
    "authors": [
        "Detmar Meurers",
        "Aleksandar Dimitrov",
        "Niels Ott",
        "Ramon Ziai"
    ],
    "description": {
        "title": "Determiners",
        "text": "Practice <em>determiners</em>."
    },
    "pipelines": [
        {
            "language": "ENGLISH",
            "descriptor": "desc/operators/OpenNlpTaggerPipe",
            "configuration": {}
        },
        {
            "language": "GERMAN",
            "descriptor": "fit:RfTaggerGermanPipeline",
            "configuration": {}
        }
    ],
    "activities": [
        {
            "activity": "color",
            "description": {
                "title": "Colour",
                "text": "In the text, VIEW shows you the determiners in <font color='#2222FF'><b>blue</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        },
        {
            "activity": "click",
            "description": {
                "title": "Click",
                "text": "Click on each determiner you find in the text and VIEW will show you whether you guessed <font color='green'><b>right</b></font> or <font color='red'><b>wrong</b></font>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.EnhancementsAndTokens",
                "configuration": {}
            }
        },
        {
            "activity": "cloze",
            "description": {
                "title": "Fill in the Blanks",
                "text": "Fill in the blanks with the <font color='green'><b>correct</b></font> determiner. If you guessed <font color='red'><b>wrong</b></font> or you find it too difficult you can get help by clicking on <span class='clozeStyleHint'>?</span>."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        },
        {
            "activity": "mc",
            "description": {
                "title": "Multiple Choice",
                "text": "Select the correct determiner."
            },
            "enhance": {
                "with": "werti.uima.enhancer.Enhancements",
                "configuration": {}
            }
        }
    ]
}
