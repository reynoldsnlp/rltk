      <fixedFlow>
        <node>TokenEnhancer</node>
        <node>HFSTRusAssistiveReadingEnhancer</node>
      </fixedFlow>
    </flowConstraints>
    <fsIndexCollection/>
    <capabilities>
      <capability>
        <inputs>
          <type allAnnotatorFeatures="true">werti.uima.types.annot.CGToken</type>
        </inputs>
        <outputs>
          <type allAnnotatorFeatures="true">werti.uima.types.Enhancement</type>
