{
  "manifest_version": 3,
  "name": "DEV Russian Language ToolKit (RLTK)",
  "version": "0.0.0.10",
  "key": "",
  "description": "Toolbar for Russian language learning, including automatic exercise generation and text analysis.",
  "icons": {
    "16":  "rltk/resources/img/RLTK-dev-16x16.png",
    "32":  "rltk/resources/img/RLTK-dev-32x32.png",
    "48":  "rltk/resources/img/RLTK-dev-48x48.png",
    "128": "rltk/resources/img/RLTK-dev-128x128.png"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "rltk/background.js"
  },
  "side_panel": {
    "default_path": "rltk/sidepanel.html"
  },
  "action": {
    "default_title": "RLTK",
    "default_icon": {
      "16":  "rltk/resources/img/RLTK-dev-16x16.png",
      "32":  "rltk/resources/img/RLTK-dev-32x32.png",
      "48":  "rltk/resources/img/RLTK-dev-48x48.png",
      "128": "rltk/resources/img/RLTK-dev-128x128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "rltk/resources/models/*.hfstol",
        "rltk/resources/models/*.pmhfst",
        "rltk/resources/models/*.cg3"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}
